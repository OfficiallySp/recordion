#include <winres.h>
#include "resource.h"
#include "Version.h"

IDI_APP ICON "recordion.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RECORDION_VERSION_RC
 PRODUCTVERSION RECORDION_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Recordion"
            VALUE "FileDescription", "Recordion game and desktop recorder"
            VALUE "FileVersion", RECORDION_VERSION_STRING
            VALUE "InternalName", "recordion"
            VALUE "LegalCopyright", "Copyright (C) 2026 Shane"
            VALUE "OriginalFilename", "recordion.exe"
            VALUE "ProductName", "Recordion"
            VALUE "ProductVersion", RECORDION_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
